# Copier ce fichier en .env puis adapter les valeurs. Le .env n'est jamais commité.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Production : une longue chaîne aléatoire, par exemple :
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=True
# Production : le sous-domaine (et le nom du conteneur nginx, pour les tests internes de Nginx Proxy Manager)
#   DJANGO_ALLOWED_HOSTS=readymatch.aaprovidir.com,readymatch_nginx
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production : https://readymatch.aaprovidir.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production derrière Nginx Proxy Manager en HTTPS : True (lit l'en-tête X-Forwarded-Proto)
DJANGO_SECURE_SSL=False
DJANGO_HSTS_SECONDS=0

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# Sans Docker (poste local) : SQLite
DATABASE_URL=sqlite:///db.sqlite3

# Avec Docker : PostgreSQL. docker-compose.yml construit lui-même DATABASE_URL à partir de ces trois valeurs.
# Mot de passe : lettres et chiffres uniquement (il est placé dans une URL), par exemple :
#   python -c "import secrets;print(secrets.token_hex(24))"
POSTGRES_DB=readymatch
POSTGRES_USER=readymatch
POSTGRES_PASSWORD=change-moi

# Dossiers (relatifs au projet)
DJANGO_STATIC_ROOT=staticfiles
DJANGO_MEDIA_ROOT=media
