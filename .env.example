# Copier ce fichier en .env puis adapter les valeurs.
# En local, les valeurs par défaut suffisent (SQLite, DEBUG actif).

DJANGO_SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Sur le VPS, ajouter le domaine avec https : https://readymatch.exemple.cm
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de données : SQLite par défaut. Sur le VPS, PostgreSQL :
# DATABASE_URL=postgres://readymatch:motdepasse@127.0.0.1:5432/readymatch
DATABASE_URL=sqlite:///db.sqlite3

# Production uniquement (derrière Nginx en HTTPS)
DJANGO_SECURE_SSL=False
DJANGO_HSTS_SECONDS=0

# Dossiers des fichiers statiques et des pièces déposées (data room)
DJANGO_STATIC_ROOT=staticfiles
DJANGO_MEDIA_ROOT=media
