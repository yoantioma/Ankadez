[Unit]
Description=ReadyMatch (Django + Gunicorn)
After=network.target postgresql.service

[Service]
User=readymatch
Group=www-data
WorkingDirectory=/srv/readymatch/app
EnvironmentFile=/srv/readymatch/app/.env
RuntimeDirectory=readymatch
RuntimeDirectoryMode=0755
ExecStart=/srv/readymatch/app/.venv/bin/gunicorn config.wsgi:application -c deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
