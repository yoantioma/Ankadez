[Unit]
Description=AnkadeZ (Django + Gunicorn)
After=network.target postgresql.service

[Service]
User=ankadez
Group=www-data
WorkingDirectory=/srv/ankadez/app
EnvironmentFile=/srv/ankadez/app/.env
RuntimeDirectory=ankadez
RuntimeDirectoryMode=0755
ExecStart=/srv/ankadez/app/.venv/bin/gunicorn config.wsgi:application -c deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
